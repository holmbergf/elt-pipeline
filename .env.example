# Copy to .env and fill in. Never commit .env.

# --- Cloudflare / Terraform (infra/) ---
export CLOUDFLARE_API_TOKEN=
export TF_VAR_cloudflare_account_id=

# --- R2 S3 API (data-integration writer) ---
# Create: R2 Overview -> Manage API tokens -> Admin Read & Write.
# The Access Key ID / Secret are shown once at token creation.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nfl
# R2_ENDPOINT_URL=   # default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Basin Catalog (Iceberg) ---
# From Terraform outputs: warehouse_catalog_uri / warehouse_warehouse (see infra/)
BASIN_CATALOG_URI=
BASIN_WAREHOUSE=
BASIN_TOKEN=
BASIN_NAMESPACE=nfl

# --- Optional local dev ---
# STORAGE_BACKEND=local   # default: r2 when R2 keys are set, else local
# LOCAL_DATA_DIR=data/raw

# --- GitHub Actions / dbt prod profile ---
# R2_S3_HOST=<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# GAMES_SOURCE=nflverse   # nflverse (default) | covers | pfr
